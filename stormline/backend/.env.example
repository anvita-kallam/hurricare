# Local Development (DuckDB - default)
# Copy to .env:  cp .env.example .env

# Databricks workspace (SQL Warehouse + Vector Search)
DATABRICKS_SERVER_HOSTNAME=adb-8472910356.12.azuredatabricks.net
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/a1b2c3d4e5f67890
DATABRICKS_PAT=dapi_a1b2c3d4e5f6789012345678901234567

# Vector Search — hurricane matching from user input
DATABRICKS_VECTOR_SEARCH_ENDPOINT_NAME=hurricare_vs_endpoint
DATABRICKS_VECTOR_SEARCH_INDEX_NAME=main.hurricare.hurricanes_index
DATABRICKS_EMBEDDING_ENDPOINT_NAME=gte-large-en-embeddings

# Set true only with real credentials and a live index (false = rule-based matching)
DATABRICKS_VECTOR_SEARCH_ENABLED=false

# Voice personal accounts (Gemini + ElevenLabs)
# GEMINI_API_KEY=your_key_from_aistudio.google.com
# ELEVENLABS_API_KEY=your_key_from_elevenlabs.io
